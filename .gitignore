.DS_Store
# Credentials - qwen_chat.py holds a live API key
qwen_chat.py
.env

# Environments and caches
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Large artifacts (training checkpoints are 90MB+, raw data is 82GB)
*.pt
*.pkl
*.npz
*.nc
data/

# ...but the four exported model artifacts DO ship. They are 29 MB together,
# well inside GitHub's limits, and without them a fresh clone cannot run any
# model - which makes the repository unreviewable. The 90 MB training
# checkpoints they were built from stay out; these are the deliverable.
!model_exports/*.pkl
_removed_*/
_quarantine_*/
logs/
nohup.out
